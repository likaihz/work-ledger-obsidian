{
  "name": "agent-ledger-obsidian",
  "version": "0.1.6",
  "description": "Read-only Agent Ledger visualization of Work Ledger data in Obsidian",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "package": "npm run build && node tools/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "npm run lint && npm run package && npm run test",
    "local:setup": "node tools/local-e2e.mjs setup",
    "local:install-package": "node tools/local-e2e.mjs install-package",
    "local:verify": "node tools/local-e2e.mjs verify"
  },
  "keywords": [
    "obsidian",
    "work-ledger",
    "task-management"
  ],
  "license": "MIT",
  "author": "litiezhu",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.4.1",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "obsidian": "1.12.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6"
  },
  "allowScripts": {
    "esbuild@0.25.5": true,
    "fsevents@2.3.3": true
  }
}
